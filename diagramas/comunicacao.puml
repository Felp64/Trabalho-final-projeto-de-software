@startuml
skinparam style strictuml
hide footbox

rectangle "Atendente: UI" as UI
rectangle "ServicoGestao" as Gestao
rectangle "KafkaProducer" as Producer
rectangle "RastreadorGateway" as Gateway

UI -> Gestao : 1: bloquearVeiculo(veiculoId)
Gestao -> Gestao : 1.1: validarStatusApolice()
